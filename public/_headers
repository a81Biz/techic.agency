/*
  # ————————————————————————————————
  # HEADERS GLOBALES DE SEGURIDAD Y POLÍTICAS
  # ————————————————————————————————
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; frame-src https://docs.google.com https://forms.gle; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://docs.google.com
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cache-Control: public, max-age=3600

# ————————————————————————————————
# CACHE LARGO PARA ASSETS CON HASH (Vite)
# ————————————————————————————————
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ————————————————————————————————
# CACHE INTERMEDIO PARA IMÁGENES SIN HASH
# ————————————————————————————————
/assets/*.jpg
  Cache-Control: public, max-age=86400
/assets/*.jpeg
  Cache-Control: public, max-age=86400
/assets/*.png
  Cache-Control: public, max-age=86400
/assets/*.webp
  Cache-Control: public, max-age=86400

# ————————————————————————————————
# INDEX.HTML SIN CACHE (SIEMPRE ACTUAL)
# ————————————————————————————————
/index.html
  Cache-Control: no-store, must-revalidate
